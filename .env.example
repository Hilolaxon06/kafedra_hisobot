# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте настоящий .env в git.

DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных. Для быстрого старта/тестов можно оставить DB_ENGINE=sqlite —
# тогда остальные DB_* переменные не читаются.
DB_ENGINE=sqlite
DB_NAME=kafedra_hisobot
DB_USER=kafedra_hisobot
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

LANGUAGE_CODE=ru
TIME_ZONE=Asia/Tashkent
